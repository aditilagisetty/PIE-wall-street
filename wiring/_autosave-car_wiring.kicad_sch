		(uuid "6e67906f-cdd9-404c-9535-1a4afabadd33")
	)
	(text "5 V SERVO: gimbal servos"
		(exclude_from_sim no)
		(at 22.86 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "85a33df0-7c1d-43f7-9e21-03ee40a17d04")
	)
	(text "NOTES"
		(exclude_from_sim no)
		(at 20.32 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9d09b179-0edf-4ccb-a331-8956e9c0f822")
	)
	(text "1. Kill switch S1 must be DC rated for 48 V (pack is 25.2 V full) and 30 A or more.\n2. Servos get their own regulator (U4) so servo current can't reset the Pi or Teensy.\n3. Teensy 4.0 pins are 3.3 V only. Never connect a 5 V signal to a Teensy pin.\n4. IMU and IR sensors run from the Teensy 3.3V pin, so I2C stays at 3.3 V.\n5. If the Teensy USB is plugged in while VIN is powered, cut the VIN-VUSB pad.\n6. ESC red BEC wires (BEC_5V) stay unconnected and taped off.\n7. All grounds are common (every GND symbol is the same net).\n8. Keep the C1/C3, D1/D2, L1/L2 leads short. Check both 5 V rails with a meter first.\n9. Optional: 60 A fuse in the + wire right after the battery."
		(exclude_from_sim no)
		(at 20.32 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "af5b6f58-45fb-4937-909e-9d3f7c6dcf9d")
	)
	(text "Laptop runs rig_control.py and connects to the Pi over Wi-Fi.\nPi forwards commands to the Teensy over UART (3.3 V both sides)."
		(exclude_from_sim no)
		(at 262.89 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bc97bc02-f84f-478e-97ed-554ad6bec7de")
	)
	(text "BT1 + to S1\nS1 to ESCs, U3, U4 VIN\nBT1 - to ESCs, regulators\nESC1 to motor 1\nESC2 to motor 2\nESC1 signal to Teensy 2\nESC2 signal to Teensy 3\nU3 out to Teensy VIN, Pi pin 2\nU4 out to servos +\nSV1 to Teensy 4\nSV2 to Teensy 5\nPi pin 8 to Teensy 0\nTeensy 1 to Pi pin 10\nTeensy 18 to IMU, IR1, IR2\nTeensy 19 to IMU, IR1, IR2\nTeensy 3.3V to IMU, IR1, IR2\nTeensy 8 to IR1 XSHUT\nTeensy 9 to IR2 XSHUT\nTeensy 6, 7 (later)"
		(exclude_from_sim no)
		(at 335.18 220.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "bcfb25ed-af94-4ed6-b54e-8592f73c4db2")
	)
	(text "5 V LOGIC: Teensy + Pi"
		(exclude_from_sim no)
		(at 22.86 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cca769d5-430e-42e2-a151-6bc3eb37c0ef")
	)
	(text "Mount flat, near the car's center."
		(exclude_from_sim no)
		(at 275.59 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d9ab3d32-6607-4e90-81f1-48e87c5b873b")
	)
	(text "BATT_RAW\nVBAT\nGND\nM1_A/B/C\nM2_A/B/C\nESC1_SIG\nESC2_SIG\n+5V_LOGIC\n+5V_SERVO\nSERVO1_SIG\nSERVO2_SIG\nUART_PI_TO_TEENSY\nUART_TEENSY_TO_PI\nI2C_SDA\nI2C_SCL\n+3V3\nIR1_XSHUT\nIR2_XSHUT\nSERVO3/4_SIG"
		(exclude_from_sim no)
		(at 305.18 220.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "f3ddc893-04c2-4590-953e-ceb61f0c5b37")
	)
