	(text "Laptop runs rig_control.py and connects to the Pi over Wi-Fi.\nPi talks to the Teensy over UART (Serial3, 3.3 V both sides)."
		(exclude_from_sim no)
		(at 330.2 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "46bdddd9-db57-4e42-b826-298504217876")
	)
	(text "ICM-45686: pin names vary by module, check the silkscreen.\nCS high = I2C mode. SDO low = address 0x68."
		(exclude_from_sim no)
		(at 365.76 114.3 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "718a2e56-a8ab-4002-b609-6404a530ef03")
	)
	(text "IR1, IR2 share I2C. Teensy holds one in reset\n(XSHUT low) at startup to give each its own address."
		(exclude_from_sim no)
		(at 365.76 180.34 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "8aec6376-8648-473e-9d86-a22663e005eb")
	)
	(text "SV3, SV4: 2nd-axis servos, added later (DNP)."
		(exclude_from_sim no)
		(at 160.02 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f0d4384e-ca41-4d4d-a311-c467e0c45ffe")
	)
	(text "NOTES"
		(exclude_from_sim no)
		(at 20.32 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "10cbbe1a-f61b-4ca2-af02-cfcda6db26ea")
	)
	(text "1. Kill switch S1 must be DC rated for 48 V (pack is 25.2 V full) and 30 A or more.\n2. U3 and U4 are Pololu D36V28F5 modules (regulator, inductor and capacitors are on the board).\n3. Servos get their own regulator (U4) so servo current can't reset the Pi or Teensy.\n4. Teensy 4.0 pins are 3.3 V only. Never connect a 5 V signal to a Teensy pin.\n5. IMU and IR sensors run from the Teensy 3.3V pin, so I2C stays at 3.3 V.\n6. If the Teensy USB is plugged in while VIN is powered, cut the VIN-VUSB pad.\n7. ESC red BEC wires (BEC_5V) stay unconnected and taped off.\n8. All grounds are common (every GND symbol is the same net).\n9. Optional: 60 A fuse in the + wire right after the battery."
		(exclude_from_sim no)
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ddf6566-ac6a-46f6-babc-989bb76e9f78")
	)
	(text "WIRE TAGS"
		(exclude_from_sim no)
		(at 297.18 215.9 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cbbe22a3-4f2e-428a-83cd-c47075324efc")
	)
	(text "W1\nW2\nW3\nW4\nW5\nW6\nW7\nW8\nW9\nW10\nW11\nW12\nW13\nW14\nW15\nW16\nW17\nW18\nW19"
		(exclude_from_sim no)
		(at 297.18 220.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "8341e1f1-3f49-4428-b508-b6ef41ea0a87")
	)
	(text "BATT_RAW\nVBAT\nGND\nM1_A/B/C\nM2_A/B/C\nESC1_SIG\nESC2_SIG\n+5V_LOGIC\n+5V_SERVO\nSERVO1_SIG\nSERVO2_SIG\nUART_TX3\nUART_RX3\nI2C_SDA\nI2C_SCL\n+3V3\nIR1_XSHUT\nIR2_XSHUT\nSERVO3/4_SIG"
		(exclude_from_sim no)
		(at 305.18 220.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "0636b7cd-7777-403e-9772-d5e9b179f0a3")
	)
	(text "BT1 + to S1\nS1 to ESCs, U3, U4 VIN\nBT1 - to everything\nESC1 to motor 1\nESC2 to motor 2\nESC1 signal to Teensy 2\nESC2 signal to Teensy 3\nU3 out to Teensy VIN, Pi pin 2\nU4 out to servos +\nSV1 to Teensy 4\nSV2 to Teensy 5\nTeensy 14 to Pi pin 10 (RXD)\nPi pin 8 (TXD) to Teensy 15\nTeensy 18 to IMU, IR1, IR2\nTeensy 19 to IMU, IR1, IR2\nTeensy 3.3V to IMU, IR1, IR2\nTeensy 20 to IR1 XSHUT\nTeensy 21 to IR2 XSHUT\nTeensy 6, 7 (later)"
		(exclude_from_sim no)
		(at 327.18 220.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "f9c70d2d-ce1e-4aee-94c4-0a42b2046616")
	)
